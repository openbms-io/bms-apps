  rdfs:comment "Applicable units are those of quantitykind:AngularAcceleration" ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/quantitykind> ;
  rdfs:label "Accelerație unghiulară"@ro ;
