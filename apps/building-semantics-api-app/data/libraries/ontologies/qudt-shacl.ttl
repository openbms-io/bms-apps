  qudt:hasDimensionVector qkdv:A0E0L3I0M0H0T0D0 ;
  qudt:hasFactorUnit [
    qudt:exponent 3 ;
    qudt:hasUnit unit:IN ;
  ] ;
  qudt:hasQuantityKind quantitykind:Volume ;
  qudt:hasReciprocalUnit unit:PER-IN3 ;
