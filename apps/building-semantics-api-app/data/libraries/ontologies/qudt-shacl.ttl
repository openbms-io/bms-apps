  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/quantitykind> ;
  rdfs:label "Group Speed of Sound"@en ;
  skos:broader quantitykind:SpeedOfSound ;
  vaem:todo "belongs to SOQ-ISO" .

