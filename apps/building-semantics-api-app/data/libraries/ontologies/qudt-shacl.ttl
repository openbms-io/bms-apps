  rdfs:label "travail"@fr ;
  rdfs:label "work"@en ;
  rdfs:label "کار"@fa ;
  rdfs:label "कार्य"@hi ;
  rdfs:label "仕事量"@ja ;
  rdfs:label "功"@zh ;
