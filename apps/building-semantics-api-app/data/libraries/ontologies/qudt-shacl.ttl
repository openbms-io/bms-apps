  qudt:uneceCommonCode "M68" ;
  qudt:uneceCommonCode "WCD" ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q920297> ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/unit> ;
  rdfs:label "Cord" ;
  rdfs:label "Cord"@en .

