  qudt:wikidataMatch <http://www.wikidata.org/entity/Q185153> ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/unit> ;
  rdfs:label "Erg" ;
  rdfs:label "Erg"@en .

