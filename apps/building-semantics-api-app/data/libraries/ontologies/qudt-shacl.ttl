  qudt:uneceCommonCode "B62" ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q910311> ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/unit> ;
  rdfs:label "Lumen Saat"@ms ;
  rdfs:label "Lumen Second" ;
  rdfs:label "Lumen Second"@en ;
