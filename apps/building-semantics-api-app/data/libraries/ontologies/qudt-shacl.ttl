  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/quantitykind> ;
  rdfs:label "Hitrost zvoka"@sl ;
  rdfs:label "Kelajuan bunyi"@ms ;
  rdfs:label "Schallgeschwindigkeit"@de ;
  rdfs:label "Ses hızı"@tr ;
