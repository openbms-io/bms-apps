  qudt:applicableUnit unit:KiloEV ;
  qudt:applicableUnit unit:KiloJ ;
  qudt:applicableUnit unit:KiloVA-HR ;
  qudt:applicableUnit unit:KiloVAR-HR ;
  qudt:applicableUnit unit:KiloW-HR ;
  qudt:applicableUnit unit:MegaBTU_IT ;
