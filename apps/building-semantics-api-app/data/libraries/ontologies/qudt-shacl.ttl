  qudt:applicableUnit unit:KiloGM-PER-J ;
  qudt:applicableUnit unit:KiloGM-PER-L-BAR ;
  qudt:applicableUnit unit:KiloGM-PER-M3-BAR ;
  qudt:applicableUnit unit:KiloGM-PER-M3-PA ;
  qudt:applicableUnit unit:KiloGM-PER-MegaBTU_IT ;
