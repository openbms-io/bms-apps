  qudt:symbol "0173-1#Z4-BAJ320#002" ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/quantitykind> ;
  rdfs:label "areic charge density or electric flux density or electric polarization"@en-US .

