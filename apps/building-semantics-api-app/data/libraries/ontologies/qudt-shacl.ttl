  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/quantitykind> ;
  rdfs:label "Elektromos mező"@hu ;
  rdfs:label "Kekuatan medan elektrik"@ms ;
  rdfs:label "câmp electric"@ro ;
