  qudt:wikidataMatch <http://www.wikidata.org/entity/Q177974> ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/unit> ;
  rdfs:label "Standard Atmosphere" ;
  rdfs:label "Standard Atmosphere"@en .

