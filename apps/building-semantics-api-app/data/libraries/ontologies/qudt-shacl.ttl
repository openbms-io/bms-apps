  qudt:hasQuantityKind quantitykind:DiffusionCoefficient ;
  qudt:hasQuantityKind quantitykind:NeutronDiffusionCoefficient ;
  qudt:hasQuantityKind quantitykind:ThermalDiffusionRatioCoefficient ;
