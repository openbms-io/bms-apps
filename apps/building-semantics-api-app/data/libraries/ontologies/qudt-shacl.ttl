  qudt:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI ;
  qudt:quantityValue constant:Value_AtomicMassConstantEnergyEquivalent ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/constant> ;
