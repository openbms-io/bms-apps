quantitykind:VolumetricFlux
  a qudt:QuantityKind ;
  dcterms:description "In fluid dynamics, the volumetric flux is the rate of volume flow across a unit area (m3·s−1·m−2).[Wikipedia]"^^qudt:LatexString ;
