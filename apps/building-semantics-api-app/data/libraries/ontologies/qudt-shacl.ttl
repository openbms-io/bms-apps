  qudt:wikidataMatch <http://www.wikidata.org/entity/Q1091059> ;
  rdfs:isDefinedBy <http://qudt.org/3.1.7/vocab/unit> ;
  rdfs:label "Abohm" ;
  rdfs:label "Abohm"@en .

