  qudt:applicableUnit unit:MilliW-PER-M2-NanoM-SR ;
  qudt:applicableUnit unit:W-PER-M2-MicroM ;
  qudt:applicableUnit unit:W-PER-M2-MicroM-SR ;
  qudt:applicableUnit unit:W-PER-M2-NanoM-SR ;
