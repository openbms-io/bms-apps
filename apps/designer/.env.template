TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# AI Provider Configuration
# -------------------------
# AI_PROVIDER: Select the AI provider to use for suggestions
# Options: "anthropic" (default) or "openai"
AI_PROVIDER=anthropic

# ANTHROPIC_API_KEY: Required when AI_PROVIDER=anthropic
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPENAI_API_KEY: Required when AI_PROVIDER=openai
# Get your API key from: https://platform.openai.com/
OPENAI_API_KEY=

# MEM0_API_KEY: Required for memory-backed AI suggestions
# Mem0 Cloud stores organization-scoped learning from user confirmations
# Get your API key from: https://app.mem0.ai/
MEM0_API_KEY=

# AI_MODEL: Optional model override
# If not set, uses provider defaults:
#   - Anthropic: claude-3-5-sonnet-20241022
#   - OpenAI: gpt-4o
AI_MODEL=
